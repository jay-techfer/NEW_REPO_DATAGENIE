    'Q3' AS Quarter
FROM AdventureWorks2022.Sales.SalesOrderHeader AS SOH
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail AS SOD
ON SOH.AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = SOD.AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory AS ST
ON SOH.AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = ST.AdventureWorks2022.Sales.SalesTerritory.TerritoryID
where SOH.AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= '2013-07-01' and SOH.AdventureWorks2022.Sales.SalesOrderHeader.OrderDate < '2013-10-01'
GROUP BY SOH.AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID, ST.AdventureWorks2022.Sales.SalesTerritory.Name

