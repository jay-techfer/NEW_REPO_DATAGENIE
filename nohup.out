sql query: ```sql
-- SSMS Query Start
SELECT YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesYear, AdventureWorks2022.Production.Product.Name AS ProductName, SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales
FROM AdventureWorks2022.Sales.SalesOrderDetail
INNER JOIN AdventureWorks2022.Sales.SalesOrderHeader ON AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID = AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID
INNER JOIN AdventureWorks2022.Production.Product ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
GROUP BY YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), AdventureWorks2022.Production.Product.Name
ORDER BY YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), AdventureWorks2022.Production.Product.Name;
