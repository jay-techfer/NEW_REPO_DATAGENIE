sql query: ```sql
-- SSMS Query Start
SELECT 
    MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesMonth,
    AdventureWorks2022.Production.Product.Name AS ProductName,
    SUM(AdventureWorks2022.Sales.SalesOrderDetail.UnitPrice * AdventureWorks2022.Sales.SalesOrderDetail.OrderQty) AS SalesTotal
FROM AdventureWorks2022.Sales.SalesOrderDetail
INNER JOIN AdventureWorks2022.Sales.SalesOrderHeader
ON AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID = AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID
INNER JOIN AdventureWorks2022.Production.Product
ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), AdventureWorks2022.Production.Product.Name
ORDER BY MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), AdventureWorks2022.Production.Product.Name;
```
