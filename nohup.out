  DISTINCT T2.FirstName,
  T2.MiddleName,
  T2.LastName
FROM AdventureWorks2022.Sales.SalesOrderHeader AS T1
INNER JOIN AdventureWorks2022.Sales.Customer AS T3
  ON T1.CustomerID = T3.CustomerID
INNER JOIN AdventureWorks2022.Person.Person AS T2
  ON T3.PersonID = T2.BusinessEntityID
