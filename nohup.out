Query
sql query: ```sql
-- SSMS Query Start
WITH YearlySales AS (
    SELECT
        YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderYear,
        AdventureWorks2022.Sales.SalesOrderHeader.CustomerID,
        SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales
    FROM AdventureWorks2022.Sales.SalesOrderHeader
    INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
        ON AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID = AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID
    GROUP BY
        YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
        AdventureWorks2022.Sales.SalesOrderHeader.CustomerID
),
RankedSales AS (
    SELECT 
        OrderYear,
        CustomerID,
        TotalSales,
        ROW_NUMBER() OVER (PARTITION BY OrderYear ORDER BY TotalSales ASC) AS RowNum
    FROM YearlySales        
)
SELECT
    rs.OrderYear,
    rs.CustomerID,
    rs.TotalSales,
    sod.LineTotal,
    soh.TaxAmt,
    YEAR(soh.OrderDate) AS OrderYearAlias,
    sod.OrderQty,
    st.Name AS TerritoryName
FROM RankedSales rs
JOIN AdventureWorks2022.Sales.SalesOrderHeader soh ON rs.CustomerID = soh.CustomerID AND rs.OrderYear = YEAR(soh.OrderDate)
JOIN AdventureWorks2022.Sales.SalesOrderDetail sod ON soh.SalesOrderID = sod.SalesOrderID
LEFT JOIN AdventureWorks2022.Sales.SalesTerritory st ON soh.TerritoryID = st.TerritoryID
WHERE rs.RowNum <= 30;
```

