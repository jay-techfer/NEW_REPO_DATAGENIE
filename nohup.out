INNER JOIN AdventureWorks2022.Sales.vIndividualCustomer
ON AdventureWorks2022.Sales.Customer.PersonID = AdventureWorks2022.Sales.vIndividualCustomer.BusinessEntityID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name,
         AdventureWorks2022.Production.Product.Name,
         MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
