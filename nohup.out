import plotly.express as px
import pandas as pd

# Drop rows with NaN, None, or blank strings in required columns
df = df.dropna(subset=['Month', 'SalesTotalInMN'])
df = df[df['Month'].astype(str).str.strip() != '']
df = df[df['SalesTotalInMN'].astype(str).str.strip() != '']

fig = px.bar(df, x='Month', y='SalesTotalInMN')
fig.show()

```
Query
sql query: ```sql
-- SSMS Query Start
SELECT AdventureWorks2022.Sales.SalesTerritory.Name AS TerritoryName,
       AdventureWorks2022.Production.Product.Name AS ProductName,
       MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS Month,
       SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) / 1000000 AS SalesTotalInMN,
       AdventureWorks2022.Sales.vIndividualCustomer.FirstName,
       AdventureWorks2022.Sales.vIndividualCustomer.LastName,
       AdventureWorks2022.Sales.SalesOrderHeader.TotalDue,
       AdventureWorks2022.Sales.SalesOrderHeader.TaxAmt,
       AdventureWorks2022.Sales.SalesOrderHeader.Freight
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Production.Product
ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory
ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
INNER JOIN AdventureWorks2022.Sales.Customer
ON AdventureWorks2022.Sales.SalesOrderHeader.CustomerID = AdventureWorks2022.Sales.Customer.CustomerID
INNER JOIN AdventureWorks2022.Sales.vIndividualCustomer
ON AdventureWorks2022.Sales.Customer.PersonID = AdventureWorks2022.Sales.vIndividualCustomer.BusinessEntityID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name,
         AdventureWorks2022.Production.Product.Name,
         MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         AdventureWorks2022.Sales.vIndividualCustomer.FirstName,
         AdventureWorks2022.Sales.vIndividualCustomer.LastName,
         AdventureWorks2022.Sales.SalesOrderHeader.TotalDue,
         AdventureWorks2022.Sales.SalesOrderHeader.TaxAmt,
         AdventureWorks2022.Sales.SalesOrderHeader.Freight
ORDER BY AdventureWorks2022.Sales.SalesTerritory.Name,
         AdventureWorks2022.Production.Product.Name,
         MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate);
```
