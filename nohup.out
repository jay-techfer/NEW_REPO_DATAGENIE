Query
sql query: ```sql
-- SSMS Query Start
SELECT AdventureWorks2022.Sales.SalesTerritory.Name, SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS SalesTotal
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
WHERE AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= DATEADD(quarter, -2, DATEFROMPARTS(2013, 12, 31)) AND AdventureWorks2022.Sales.SalesOrderHeader.OrderDate <= DATEFROMPARTS(2013, 12, 31)
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name;
```
query: SELECT AdventureWorks2022.Sales.SalesTerritory.Name, SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS SalesTotal
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
WHERE AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= DATEADD(quarter, -2, DATEFROMPARTS(2013, 12, 31)) AND AdventureWorks2022.Sales.SalesOrderHeader.OrderDate <= DATEFROMPARTS(2013, 12, 31)
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name;
Query
sql query: ```sql
-- SSMS Query Start
SELECT
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID,
    AdventureWorks2022.Sales.SalesTerritory.Name,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 3 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q3Sales,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 4 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q4Sales
FROM
    AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN
    AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
WHERE
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID, AdventureWorks2022.Sales.SalesTerritory.Name
ORDER BY
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID;
```
