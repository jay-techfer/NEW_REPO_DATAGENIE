sql query: ```sql
-- SSMS Query Start
SELECT
    AdventureWorks2022.Sales.SalesTerritory.Name AS TerritoryName,
    AdventureWorks2022.Production.Product.Name AS ProductName,
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesYear,
    DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesQuarter,
    MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesMonth,
    SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS QuarterlySalesTotal
FROM
    AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN
    AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN
    AdventureWorks2022.Production.Product ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
INNER JOIN
    AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
GROUP BY
    AdventureWorks2022.Sales.SalesTerritory.Name,
    AdventureWorks2022.Production.Product.Name,
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
    DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
    MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate)
ORDER BY
    AdventureWorks2022.Sales.SalesTerritory.Name,
    AdventureWorks2022.Production.Product.Name,
    SalesYear,
    SalesQuarter,
    SalesMonth;
```

