sql query: ```sql
-- SSMS Query Start
SELECT
    AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 1 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q1,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q2,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 3 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q3,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 4 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q4
FROM
    AdventureWorks2022.Sales.SalesOrderHeader
WHERE
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY
    AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID;
```
