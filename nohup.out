Query
sql query: ```sql
-- SSMS Query Start
SELECT
    AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID,
    SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) as TotalSalesQ3,
    'Q3' AS Quarter
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
where AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= '2013-07-01' and AdventureWorks2022.Sales.SalesOrderHeader.OrderDate < '2013-10-01'
GROUP BY AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID

UNION

SELECT
    AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID,
    SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) as TotalSalesQ4,
    'Q4' AS Quarter
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
where AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= '2013-10-01' and AdventureWorks2022.Sales.SalesOrderHeader.OrderDate < '2014-01-01'
GROUP BY AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID
ORDER BY Quarter
