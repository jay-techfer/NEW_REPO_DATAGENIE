sql query: ```sql
-- SSMS Query Start
WITH YearlySales AS (
    SELECT
        AdventureWorks2022.Sales.SalesOrderHeader.CustomerID,
        YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesYear,
        SUM(AdventureWorks2022.Sales.SalesOrderHeader.TotalDue) AS TotalSales,
        SUM(AdventureWorks2022.Sales.SalesOrderHeader.TaxAmt) AS TotalTaxAmt,
        SUM(AdventureWorks2022.Sales.SalesOrderDetail.OrderQty) AS TotalOrderQty
    FROM AdventureWorks2022.Sales.SalesOrderHeader
    JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
    GROUP BY AdventureWorks2022.Sales.SalesOrderHeader.CustomerID, YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate)
),
RankedSales AS (
    SELECT 
        CustomerID,
        SalesYear,
        TotalSales,
        TotalTaxAmt,
        TotalOrderQty,
        RANK() OVER (PARTITION BY SalesYear ORDER BY TotalSales ASC) AS SalesRank
    FROM YearlySales
)
SELECT 
    rs.CustomerID,
    p.FirstName AS CustomerFirstName,
    p.LastName AS CustomerLastName,
    rs.SalesYear,
    rs.TotalSales,
    rs.TotalTaxAmt,
    rs.TotalOrderQty,
    st.Name as TerritoryName
FROM RankedSales rs
JOIN AdventureWorks2022.Sales.Customer c ON rs.CustomerID = c.CustomerID
JOIN AdventureWorks2022.Person.Person p ON c.PersonID = p.BusinessEntityID
LEFT JOIN AdventureWorks2022.Sales.SalesTerritory st ON c.TerritoryID = st.TerritoryID
WHERE rs.SalesRank <= 30
ORDER BY rs.SalesYear, rs.SalesRank;
