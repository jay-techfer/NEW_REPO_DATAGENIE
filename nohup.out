sql query: -- SSMS Query Start
SELECT DISTINCT
    AdventureWorks2022.Sales.vIndividualCustomer.FirstName,
    AdventureWorks2022.Sales.vIndividualCustomer.LastName,
    AdventureWorks2022.Sales.vIndividualCustomer.City,
    AdventureWorks2022.Sales.vIndividualCustomer.StateProvinceName,
    AdventureWorks2022.Sales.vIndividualCustomer.CountryRegionName
FROM
    AdventureWorks2022.Sales.Customer AS c
INNER JOIN
    AdventureWorks2022.Sales.vIndividualCustomer AS vic
    ON c.PersonID = vic.BusinessEntityID
WHERE
    c.CustomerID IN (
        SELECT
            AdventureWorks2022.Sales.SalesOrderHeader.CustomerID
        FROM
            AdventureWorks2022.Sales.SalesOrderHeader
        WHERE
            YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
        GROUP BY
            AdventureWorks2022.Sales.SalesOrderHeader.CustomerID
        HAVING
            COUNT(AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID) < 5
    );
