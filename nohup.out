    AdventureWorks2022.Sales.SalesOrderDetail.OrderQty,
    AdventureWorks2022.Sales.SalesOrderHeader.SubTotal,
    AdventureWorks2022.Sales.SalesOrderHeader.TaxAmt,
    AdventureWorks2022.Sales.SalesTerritory.Name as TerritoryName
FROM AdventureWorks2022.Sales.Customer
INNER JOIN AdventureWorks2022.Sales.SalesOrderHeader 
ON AdventureWorks2022.Sales.SalesOrderHeader.CustomerID = AdventureWorks2022.Sales.Customer.CustomerID
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID = AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory
ON AdventureWorks2022.Sales.SalesTerritory.TerritoryID = AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID
ORDER BY AdventureWorks2022.Sales.SalesOrderHeader.SubTotal DESC;
```

