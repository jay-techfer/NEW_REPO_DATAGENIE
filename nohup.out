import plotly.express as px
import pandas as pd

# Drop rows with missing values in 'ProductNumber' or 'ProductColor'
df = df.dropna(subset=['ProductNumber', 'ProductColor'])
df = df[df['ProductNumber'] != '']
df = df[df['ProductColor'] != '']


# Create the line chart using Plotly Express
fig = px.line(df, 
              x='ProductNumber', 
              y='ProductColor',
              color='ProductColor',  # Color lines by product color
              title='Line Chart for Each Product Color') 

fig.show()

