Query
sql query: -- SSMS Query Start
SELECT
  YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderYear,
  DATEPART(qq, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderQuarter,
  AdventureWorks2022.Sales.SalesTerritory.Name AS TerritoryName,
  AdventureWorks2022.Production.Product.Name AS ProductName,
  SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
  ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory
  ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
INNER JOIN AdventureWorks2022.Production.Product
  ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
WHERE
  YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013 AND DATEPART(qq, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) IN (3, 4)
GROUP BY
  YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
  DATEPART(qq, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
  AdventureWorks2022.Sales.SalesTerritory.Name,
  AdventureWorks2022.Production.Product.Name
