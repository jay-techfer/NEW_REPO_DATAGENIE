sql query: ```sql
-- SSMS Query Start
SELECT 
    AdventureWorks2022.Sales.SalesTerritory.Name AS SalesTerritoryName,
    AdventureWorks2022.Sales.SalesTerritory.SalesYTD,
    AdventureWorks2022.Sales.SalesTerritory.SalesLastYear,
    AdventureWorks2022.Sales.SalesPerson.Bonus,
    AdventureWorks2022.Sales.SalesPerson.CommissionPct,
    AdventureWorks2022.Sales.SalesPerson.SalesYTD AS SalesPersonSalesYTD,
    AdventureWorks2022.Sales.SalesPerson.SalesLastYear AS SalesPersonSalesLastYear,
    AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID,
    AdventureWorks2022.Sales.SalesOrderHeader.OrderDate,
    AdventureWorks2022.Sales.SalesOrderHeader.TotalDue,
    AdventureWorks2022.Sales.Customer.CustomerID,
    AdventureWorks2022.Production.Product.ProductID,
    AdventureWorks2022.Production.Product.Name AS ProductName
FROM AdventureWorks2022.Sales.SalesTerritory
INNER JOIN AdventureWorks2022.Sales.SalesPerson 
ON AdventureWorks2022.Sales.SalesTerritory.TerritoryID = AdventureWorks2022.Sales.SalesPerson.TerritoryID
INNER JOIN AdventureWorks2022.Sales.SalesOrderHeader 
ON AdventureWorks2022.Sales.SalesPerson.BusinessEntityID = AdventureWorks2022.Sales.SalesOrderHeader.SalesPersonID
INNER JOIN AdventureWorks2022.Sales.Customer
ON AdventureWorks2022.Sales.SalesOrderHeader.CustomerID = AdventureWorks2022.Sales.Customer.CustomerID
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Production.Product
ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID;
```
