sql query: ```sql
-- SSMS Query Start
SELECT
    OrderYear,
    CustomerID
FROM (
    SELECT
        AdventureWorks2022.Sales.Customer.CustomerID,
        YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderYear,
        ROW_NUMBER() OVER (PARTITION BY YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) ORDER BY AdventureWorks2022.Sales.SalesOrderHeader.SubTotal ASC) as rn
    FROM AdventureWorks2022.Sales.Customer
    INNER JOIN AdventureWorks2022.Sales.SalesOrderHeader 
    ON AdventureWorks2022.Sales.SalesOrderHeader.CustomerID = AdventureWorks2022.Sales.Customer.CustomerID
) t
WHERE rn <= 30;
