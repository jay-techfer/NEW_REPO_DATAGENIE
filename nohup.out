Predictive
Query
sql query: ```sql
-- SSMS Query Start
WITH YearlySales AS (
    SELECT
        AdventureWorks2022.Sales.SalesOrderHeader.CustomerID,
        YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS SalesYear,
        SUM(AdventureWorks2022.Sales.SalesOrderHeader.TotalDue) AS TotalSales
    FROM AdventureWorks2022.Sales.SalesOrderHeader
    GROUP BY AdventureWorks2022.Sales.SalesOrderHeader.CustomerID, YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate)
),
RankedSales AS (
    SELECT 
        CustomerID,
        SalesYear,
        TotalSales,
        RANK() OVER (PARTITION BY SalesYear ORDER BY TotalSales DESC) AS SalesRank
    FROM YearlySales
)
SELECT 
    c.CustomerID,
    p.FirstName AS CustomerFirstName,
    p.LastName AS CustomerLastName,
    rs.SalesYear,
    rs.TotalSales
FROM RankedSales rs
JOIN AdventureWorks2022.Sales.Customer c ON rs.CustomerID = c.CustomerID
JOIN AdventureWorks2022.Person.Person p ON c.PersonID = p.BusinessEntityID
WHERE rs.SalesRank <= 30
ORDER BY rs.SalesYear, rs.SalesRank;
```
