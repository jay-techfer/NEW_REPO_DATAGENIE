[SQL: SELECT
    CONCAT(
        AdventureWorks2022.Person.Person.FirstName,
        ' ',
        ISNULL(AdventureWorks2022.Person.Person.MiddleName + ' ', ''),
        AdventureWorks2022.Person.Person.LastName
    ) AS "Employee Full Name",
    AdventureWorks2022.Sales.SalesTerritory.Name AS "Territory Name",
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS "Sales Year",
    SUM(AdventureWorks2022.Sales.SalesOrderHeader.TotalDue) AS "Total Sales Amount",
    COUNT(AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID) AS "Total Orders Count",
    AVG(AdventureWorks2022.Sales.SalesOrderHeader.TotalDue) AS "Average Order Amount"
FROM
    AdventureWorks2022.Sales.SalesOrderHeader AS soh
INNER JOIN
    AdventureWorks2022.Sales.SalesPerson AS sp
    ON soh.SalesPersonID = sp.BusinessEntityID
INNER JOIN
    AdventureWorks2022.Person.Person AS p
    ON sp.BusinessEntityID = p.BusinessEntityID
INNER JOIN
    AdventureWorks2022.Sales.SalesTerritory AS st
    ON soh.TerritoryID = st.TerritoryID
WHERE
    soh.SalesPersonID IS NOT NULL
    AND YEAR(soh.OrderDate) IN (2011, 2012, 2013, 2014)
GROUP BY
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
    AdventureWorks2022.Person.Person.FirstName,
    AdventureWorks2022.Person.Person.MiddleName,
    AdventureWorks2022.Person.Person.LastName,
    AdventureWorks2022.Sales.SalesTerritory.Name
ORDER BY
    "Sales Year",
    "Employee Full Name",
    "Territory Name";]
