chart code :  ```python
import plotly.express as px
import pandas as pd

# Assuming df exists and is a Pandas DataFrame

# Drop rows with NaN/blank values in Q3Sales, Q4Sales, and Month
df_cleaned = df.dropna(subset=['Q3Sales', 'Q4Sales', 'Month']).copy()  # Explicitly copy to avoid SettingWithCopyWarning
df_cleaned = df_cleaned[~df_cleaned['Month'].isin(['', ' '])]  # Remove rows where 'Month' is blank

# Melt the DataFrame for easier plotting with Plotly Express
df_melted = pd.melt(df_cleaned, id_vars=['Month'], value_vars=['Q3Sales', 'Q4Sales'], 
                   variable_name='Quarter', value_name='Sales')


# Bar Chart
fig_bar = px.bar(df_melted, x='Sales', y='Month', color='Quarter', 
                 barmode='group', title='Sales by Quarter and Month (Bar Chart)')

# Line Chart
fig_line = px.line(df_melted, x='Sales', y='Month', color='Quarter',
                   title='Sales by Quarter and Month (Line Chart)')

fig_bar.show()
fig_line.show()

```
