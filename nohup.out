Query
sql query: ```sql
-- SSMS Query Start
SELECT AdventureWorks2022.Sales.SalesTerritory.Name,
SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 1 THEN AdventureWorks2022.Sales.SalesOrderDetail.LineTotal ELSE 0 END) AS Q1Sales,
SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2 THEN AdventureWorks2022.Sales.SalesOrderDetail.LineTotal ELSE 0 END) AS Q2Sales,
SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 3 THEN AdventureWorks2022.Sales.SalesOrderDetail.LineTotal ELSE 0 END) AS Q3Sales,
SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 4 THEN AdventureWorks2022.Sales.SalesOrderDetail.LineTotal ELSE 0 END) AS Q4Sales
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name
ORDER BY AdventureWorks2022.Sales.SalesTerritory.Name;
```

