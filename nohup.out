Query
sql query: ```sql
-- SSMS Query Start
SELECT AdventureWorks2022.Sales.SalesTerritory.Name AS TerritoryName,
       SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail
ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory
ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
WHERE AdventureWorks2022.Sales.SalesOrderHeader.OrderDate >= DATEADD(quarter, -2, DATEFROMPARTS(YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), 1, 1))
  AND AdventureWorks2022.Sales.SalesOrderHeader.OrderDate < DATEFROMPARTS(YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) + 1, 1, 1) and YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name;
