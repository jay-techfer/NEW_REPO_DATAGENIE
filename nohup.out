sql query: ```sql
-- SSMS Query Start
SELECT AdventureWorks2022.Sales.SalesTerritory.Name, 
       SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales, 
       DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS QuarterNo,
       YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS YearNo,
       MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS MonthNo,
       AdventureWorks2022.Production.Product.Name AS ProductName
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
INNER JOIN AdventureWorks2022.Production.Product ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
  AND DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) IN (3, 4)
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name, 
         DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         AdventureWorks2022.Production.Product.Name;
```
query: SELECT AdventureWorks2022.Sales.SalesTerritory.Name, 
       SUM(AdventureWorks2022.Sales.SalesOrderDetail.LineTotal) AS TotalSales, 
       DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS QuarterNo,
       YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS YearNo,
       MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS MonthNo,
       AdventureWorks2022.Production.Product.Name AS ProductName
FROM AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
INNER JOIN AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
INNER JOIN AdventureWorks2022.Production.Product ON AdventureWorks2022.Sales.SalesOrderDetail.ProductID = AdventureWorks2022.Production.Product.ProductID
WHERE YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
  AND DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) IN (3, 4)
GROUP BY AdventureWorks2022.Sales.SalesTerritory.Name, 
         DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate),
         AdventureWorks2022.Production.Product.Name;
