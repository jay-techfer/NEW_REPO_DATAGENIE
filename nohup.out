Query
sql query: ```sql
-- SSMS Query Start
SELECT
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID,
    AdventureWorks2022.Sales.SalesTerritory.Name,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 3 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q3Sales,
    SUM(CASE WHEN DATEPART(QUARTER, AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 4 THEN AdventureWorks2022.Sales.SalesOrderHeader.TotalDue ELSE 0 END) AS Q4Sales,
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderYear,
    MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) AS OrderMonth,
    AdventureWorks2022.Sales.SalesOrderDetail.ProductID
FROM
    AdventureWorks2022.Sales.SalesOrderHeader
INNER JOIN
    AdventureWorks2022.Sales.SalesTerritory ON AdventureWorks2022.Sales.SalesOrderHeader.TerritoryID = AdventureWorks2022.Sales.SalesTerritory.TerritoryID
INNER JOIN 
    AdventureWorks2022.Sales.SalesOrderDetail ON AdventureWorks2022.Sales.SalesOrderHeader.SalesOrderID = AdventureWorks2022.Sales.SalesOrderDetail.SalesOrderID
WHERE
    YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate) = 2013
GROUP BY
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID, AdventureWorks2022.Sales.SalesTerritory.Name, YEAR(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), MONTH(AdventureWorks2022.Sales.SalesOrderHeader.OrderDate), AdventureWorks2022.Sales.SalesOrderDetail.ProductID
ORDER BY
    AdventureWorks2022.Sales.SalesTerritory.TerritoryID;
```
