sql query: -- SSMS Query Start
SELECT
  TOP 10
  AdventureWorks2022.Sales.Customer.CustomerID,
  COALESCE(
    AdventureWorks2022.Sales.vIndividualCustomer.FirstName + ' ' + ISNULL(AdventureWorks2022.Sales.vIndividualCustomer.MiddleName + ' ', '') + AdventureWorks2022.Sales.vIndividualCustomer.LastName,
    AdventureWorks2022.Sales.vStoreWithDemographics.Name
  ) AS CustomerName,
  SUM(AdventureWorks2022.Sales.SalesOrderHeader.TotalDue) AS TotalPurchaseValue
FROM AdventureWorks2022.Sales.SalesOrderHeader AS T1
INNER JOIN AdventureWorks2022.Sales.Customer AS T2
  ON T1.CustomerID = T2.CustomerID
LEFT JOIN AdventureWorks2022.Sales.vIndividualCustomer AS T3
  ON T2.PersonID = T3.BusinessEntityID
LEFT JOIN AdventureWorks2022.Sales.vStoreWithDemographics AS T4
  ON T2.StoreID = T4.BusinessEntityID
WHERE
  YEAR(T1.OrderDate) BETWEEN 2013 AND 2014
GROUP BY
  AdventureWorks2022.Sales.Customer.CustomerID,
  COALESCE(
    AdventureWorks2022.Sales.vIndividualCustomer.FirstName + ' ' + ISNULL(AdventureWorks2022.Sales.vIndividualCustomer.MiddleName + ' ', '') + AdventureWorks2022.Sales.vIndividualCustomer.LastName,
    AdventureWorks2022.Sales.vStoreWithDemographics.Name
  )
ORDER BY
  TotalPurchaseValue DESC;
