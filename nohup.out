chart code :  ```python
import plotly.express as px
import pandas as pd

# Assuming df is already defined and populated

# Drop rows with NaN, None, or blank strings in 'Month', 'Q3Sales', 'Q4Sales'
df = df.dropna(subset=['Month', 'Q3Sales', 'Q4Sales'])
df = df[~df['Month'].isin(['', ' '])] # Exclude blank strings for 'Month' which dropna misses
df = df[~df['Q3Sales'].isin(['', ' '])] # Exclude blank strings for 'Q3Sales'
df = df[~df['Q4Sales'].isin(['', ' '])] # Exclude blank strings for 'Q4Sales'

# Convert Q3Sales and Q4Sales to numeric if they are not already
df['Q3Sales'] = pd.to_numeric(df['Q3Sales'], errors='coerce')
df['Q4Sales'] = pd.to_numeric(df['Q4Sales'], errors='coerce')
df = df.dropna(subset=['Q3Sales', 'Q4Sales'])

fig = px.bar(df, x='Month', y=['Q3Sales', 'Q4Sales'], barmode='group')
fig.show()

```

