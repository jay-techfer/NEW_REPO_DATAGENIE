import plotly.express as px
import pandas as pd

# Drop rows with NaN, None, or blank strings in the specified columns
df = df.dropna(subset=['Q3Sales', 'Q4Sales', 'Month'])
df = df[~df['Q3Sales'].isin([None, ''])]
df = df[~df['Q4Sales'].isin([None, ''])]
df = df[~df['Month'].isin([None, ''])]


# Bar chart
fig_bar = px.bar(df, x=['Q3Sales', 'Q4Sales'], y='Month', title='Sales by Quarter')
fig_bar.show()

# Line chart -  Requires some data manipulation to be effective with two x-axis columns
df_melted = pd.melt(df, id_vars=['Month'], value_vars=['Q3Sales', 'Q4Sales'], var_name='Quarter', value_name='Sales')
fig_line = px.line(df_melted, x='Month', y='Sales', color='Quarter', title='Sales Trend by Quarter')
fig_line.show()

